#!/bin/zsh

set -euo pipefail

SANDBOX_EXEC="/usr/bin/sandbox-exec"
OFFLINE_PROFILE='(version 1)(allow default)(deny network*)'

if [[ ! -x "${SANDBOX_EXEC}" ]]; then
  print -u2 "error: sandbox-exec is required to enforce network isolation"
  exit 2
fi

if (( $# == 0 )); then
  print -u2 "usage: Scripts/run-with-network-denied command [arguments ...]"
  exit 2
fi

exec "${SANDBOX_EXEC}" -p "${OFFLINE_PROFILE}" "$@"
