#!/bin/zsh

set -euo pipefail

SCRIPT_DIR="${0:A:h}"
NETWORK_DENIED_RUNNER="${SCRIPT_DIR}/run-with-network-denied"
TEST_BUNDLE="${1:-}"

if [[ -z "${TEST_BUNDLE}" ]]; then
  print -u2 "usage: Scripts/run-xctest-bundle-with-network-denied /absolute/path/to/Tests.xctest"
  exit 2
fi

if [[ ! -d "${TEST_BUNDLE}" ]]; then
  print -u2 "error: test bundle does not exist: ${TEST_BUNDLE}"
  exit 2
fi

exec "${NETWORK_DENIED_RUNNER}" /usr/bin/xcrun xctest "${TEST_BUNDLE}"
